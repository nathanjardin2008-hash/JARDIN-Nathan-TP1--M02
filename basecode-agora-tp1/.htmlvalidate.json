{
  "extends": ["html-validate:recommended"],
  "rules": {
    "doctype-style": "off",
    "void-style": "off",
    "attribute-boolean-style": "off",
    "attribute-empty-style": "off",
    "no-trailing-whitespace": "off",
    "no-inline-style": "off",
    "wcag/h32": "off",
    "form-dup-name": ["error", { "shared": ["radio", "checkbox", "button", "submit", "reset"] }]
  }
}
